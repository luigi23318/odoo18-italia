<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_acube" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.acube</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="A-Cube Bridge" name="acube_bridge_settings">
                    <setting
                        string="Ambiente"
                        help="Seleziona Sandbox per i test o Produzione per l'uso reale.">
                        <field name="acube_environment"/>
                    </setting>
                    <setting
                        string="Credenziali A-Cube"
                        help="Inserisci le credenziali del tuo account A-Cube (acubeapi.com).">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="acube_email" class="col-3 col-lg-3"/>
                                <field name="acube_email" class="col-4 col-lg-4"
                                       placeholder="email@esempio.com"/>
                            </div>
                            <div class="row mt8">
                                <label for="acube_password" class="col-3 col-lg-3"/>
                                <field name="acube_password" class="col-4 col-lg-4"
                                       password="True"
                                       placeholder="Password"/>
                            </div>
                            <div class="mt16">
                                <button name="action_acube_test_connection"
                                        string="🔌 Testa Connessione"
                                        type="object"
                                        class="btn-primary"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
