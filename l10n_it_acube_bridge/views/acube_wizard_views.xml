<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- WIZARD: Import fattura estera da PDF                                -->
    <!-- ================================================================== -->

    <record id="acube_import_pdf_wizard_form" model="ir.ui.view">
        <field name="name">acube.import.pdf.wizard.form</field>
        <field name="model">acube.import.pdf.wizard</field>
        <field name="arch" type="xml">
            <form string="Importa fattura estera da PDF">

                <!-- ===== STEP 1: UPLOAD ===== -->
                <div invisible="state != 'upload'">
                    <div class="alert alert-info" role="alert">
                        <strong>Conversione PDF → Fattura Odoo con AI</strong>
                        <p class="mb0">
                            Carica il PDF di una fattura estera. L'intelligenza artificiale
                            di A-Cube analizzerà il documento, estrarrà i dati e creerà
                            una bozza di fattura fornitore in Odoo.
                        </p>
                    </div>
                    <group>
                        <group string="File da convertire">
                            <field name="pdf_file" filename="pdf_filename"
                                   widget="binary"/>
                            <field name="pdf_filename" invisible="1"/>
                        </group>
                        <group string="Opzioni di conversione">
                            <field name="default_vat_rate"/>
                            <field name="convert_amounts"/>
                        </group>
                    </group>
                </div>

                <!-- ===== STEP 2: PROCESSING ===== -->
                <div invisible="state != 'processing'">
                    <div class="alert alert-warning" role="alert">
                        <strong>⏳ Elaborazione in corso...</strong>
                        <p class="mb0">
                            L'AI di A-Cube sta analizzando il PDF.
                            L'operazione richiede generalmente 10-30 secondi.
                            Non chiudere questa finestra.
                        </p>
                    </div>
                    <group>
                        <field name="job_uuid" readonly="1"/>
                        <field name="job_status" readonly="1"/>
                        <field name="job_error" readonly="1"
                               invisible="not job_error"/>
                    </group>
                </div>

                <!-- ===== STEP 3: REVIEW ===== -->
                <div invisible="state != 'review'">
                    <div class="alert alert-warning" role="alert">
                        <strong>⚠️ Verifica i dati estratti</strong>
                        <p class="mb0">
                            L'AI potrebbe aver estratto dati incompleti o errati.
                            <strong>Controlla tutto</strong> prima di creare la fattura.
                            In particolare, seleziona il <strong>Tipo Documento</strong>
                            corretto (TD17/TD18/TD19 per autofatture) perché
                            l'AI non lo determina automaticamente.
                        </p>
                    </div>

                    <group>
                        <group string="Dati fornitore">
                            <field name="supplier_name"/>
                            <field name="supplier_vat"/>
                            <field name="supplier_country_code"/>
                        </group>
                        <group string="Dati documento">
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="total_amount"/>
                            <field name="currency_code" readonly="1"/>
                            <field name="tipo_documento"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <separator string="Righe fattura"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="vat_rate"/>
                            <field name="subtotal" sum="Totale"/>
                        </list>
                    </field>

                    <!-- Dati grezzi — visibili solo in debug mode -->
                    <group string="Dati grezzi (debug)" invisible="1">
                        <field name="extracted_json" widget="text"/>
                        <field name="extracted_xml" widget="text"/>
                    </group>
                </div>

                <!-- ===== STEP 4: DONE ===== -->
                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        <strong>✅ Fattura fornitore creata con successo!</strong>
                        <p class="mb0">
                            La fattura è stata creata in bozza.
                            Il PDF originale e l'XML FatturaPA sono allegati alla fattura.
                            Verifica i dati e conferma quando pronto.
                        </p>
                    </div>
                    <group>
                        <field name="invoice_id" readonly="1"/>
                    </group>
                </div>

                <field name="state" invisible="1"/>

                <!-- ===== FOOTER CON BOTTONI ===== -->
                <footer>
                    <button name="action_upload_and_extract"
                            string="📤 Carica e Analizza con AI"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_create_invoice"
                            string="✅ Crea Fattura Fornitore"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'review'"/>
                    <button string="Chiudi"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- AZIONE per aprire il wizard                                         -->
    <!-- ================================================================== -->

    <record id="action_acube_import_pdf" model="ir.actions.act_window">
        <field name="name">Importa fattura da PDF (A-Cube AI)</field>
        <field name="res_model">acube.import.pdf.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================================================================== -->
    <!-- MENU: voce sotto Contabilità → Fornitori                           -->
    <!-- ================================================================== -->

    <menuitem id="menu_acube_import_pdf"
              name="Importa fattura estera da PDF"
              parent="account.menu_finance_payables"
              action="action_acube_import_pdf"
              sequence="100"/>

</odoo>
