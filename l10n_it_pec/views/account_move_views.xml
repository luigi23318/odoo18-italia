<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         Vista Fattura: Bottoni PEC e campi informativi
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_move_form_pec" model="ir.ui.view">
        <field name="name">account.move.form.pec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Bottoni PEC nella barra superiore -->
            <xpath expr="//header" position="inside">
                <button name="action_l10n_it_pec_send"
                        string="📨 Invia via PEC"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or l10n_it_edi_transaction"
                        groups="l10n_it_pec.group_pec_manager"/>
                <button name="action_l10n_it_pec_preview_xml"
                        string="👁 Anteprima XML"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"
                        groups="l10n_it_pec.group_pec_manager"/>
                <button name="action_l10n_it_pec_reset_edi"
                        string="⟲ Annulla invio EDI"
                        type="object"
                        class="btn-secondary text-warning"
                        icon="fa-undo"
                        confirm="Resettare lo stato EDI di questa fattura? Dopo il reset sarà possibile riportarla a bozza."
                        invisible="not l10n_it_pec_show_reset_edi"
                        groups="l10n_it_pec.group_pec_manager"/>
                <field name="l10n_it_pec_show_reset_edi" invisible="1"/>
            </xpath>

            <!-- Blocco firma digitale PA -->
            <xpath expr="//header" position="after">
                <div invisible="not l10n_it_pec_signature_required or move_type not in ('out_invoice', 'out_refund')">
                    <!-- Stato: in attesa di firma -->
                    <div class="alert alert-warning mb-0"
                         role="alert"
                         invisible="l10n_it_pec_signature_state != 'awaiting'">
                        <strong>Firma digitale richiesta</strong> —
                        Fattura PA: scaricare l'XML, firmarlo e ricaricare.
                    </div>

                    <!-- Stato: firmato -->
                    <div class="alert alert-success mb-0"
                         role="alert"
                         invisible="l10n_it_pec_signature_state != 'signed'">
                        <strong>Firmato digitalmente</strong> —
                        <field name="l10n_it_pec_signed_attachment_id" readonly="1" nolabel="1" class="d-inline"/>
                    </div>

                    <!-- Bottoni firma -->
                    <div class="mt-2">
                        <button name="action_l10n_it_pec_download_xml"
                                string="Scarica XML per firma"
                                type="object"
                                class="btn-link"
                                icon="fa-download"
                                invisible="l10n_it_pec_signature_state != 'awaiting'"/>
                        <button name="action_l10n_it_pec_upload_signed"
                                string="Carica XML firmato"
                                type="object"
                                class="btn-link"
                                icon="fa-upload"
                                invisible="l10n_it_pec_signature_state != 'awaiting'"/>
                        <button name="action_l10n_it_pec_remove_signed"
                                string="Rimuovi firma"
                                type="object"
                                class="btn-link text-danger"
                                icon="fa-trash"
                                confirm="Rimuovere il file firmato?"
                                invisible="l10n_it_pec_signature_state != 'signed'"/>
                    </div>
                </div>
            </xpath>

            <!-- Campi informativi PEC nel tab "Altre informazioni" -->
            <xpath expr="//page[@name='other_info']//group[last()]" position="after">
                <group string="Invio PEC SDI" name="pec_info"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <field name="l10n_it_pec_sent_date" readonly="1"/>
                        <field name="l10n_it_pec_message_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="l10n_it_pec_xml_attachment_id" readonly="1"/>
                        <field name="l10n_it_pec_last_error" readonly="1"
                               invisible="not l10n_it_pec_last_error"
                               widget="text"/>
                    </group>
                </group>
                <group string="Ricezione PEC SDI" name="pec_info_in"
                       invisible="move_type not in ('in_invoice', 'in_refund') or not l10n_it_pec_sdi_identifier">
                    <field name="l10n_it_pec_sdi_identifier" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Vista Lista: Colonna stato PEC
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_move_tree_pec" model="ir.ui.view">
        <field name="name">account.move.tree.pec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="l10n_it_pec_sent_date" string="Inviata PEC"
                       optional="hide" width="0.8"/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Server Action: Sincronizza PEC SDI (menu globale)
         ═══════════════════════════════════════════════════════════════ -->
    <record id="action_l10n_it_pec_sync_inbox" model="ir.actions.server">
        <field name="name">Sincronizza PEC SDI</field>
        <field name="model_id" ref="l10n_it_pec.model_l10n_it_pec_mail_handler"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Sincronizzazione PEC SDI completata',
        'message': 'Controllo casella PEC eseguito. Eventuali nuove notifiche SDI e fatture passive sono state elaborate.',
        'type': 'success',
        'sticky': False,
    },
}
model._cron_poll_pec_inbox()
        </field>
        <field name="groups_id" eval="[(4, ref('l10n_it_pec.group_pec_manager'))]"/>
    </record>

    <!-- Menu: Contabilità → 📥 Sincronizza PEC SDI (top bar) -->
    <menuitem id="menu_l10n_it_pec_sync_inbox"
              name="📥 Sincronizza PEC SDI"
              parent="account.menu_finance"
              action="action_l10n_it_pec_sync_inbox"
              sequence="100"
              groups="l10n_it_pec.group_pec_manager"/>

    <!-- ═══════════════════════════════════════════════════════════════
         Azione server: Invio PEC massivo (da lista fatture)
         ═══════════════════════════════════════════════════════════════ -->
    <record id="action_pec_send_wizard" model="ir.actions.act_window">
        <field name="name">Invia via PEC allo SDI</field>
        <field name="res_model">l10n_it_pec.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('l10n_it_pec.group_pec_manager'))]"/>
    </record>

</odoo>
