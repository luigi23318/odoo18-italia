<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         Wizard: Invio massivo PEC
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_pec_send_wizard_form" model="ir.ui.view">
        <field name="name">l10n_it_pec.send.wizard.form</field>
        <field name="model">l10n_it_pec.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Invio PEC allo SDI">
                <group>
                    <group>
                        <field name="pec_mode" readonly="1"/>
                        <field name="count_total" readonly="1"/>
                        <field name="count_sendable" readonly="1"/>
                        <field name="count_already_sent" readonly="1"/>
                    </group>
                </group>

                <div class="alert alert-info" role="alert"
                     invisible="pec_mode != 'demo'">
                    <strong>Modalità DEMO:</strong>
                    l'XML verrà generato ma non verrà inviato nulla.
                    Utile per verificare la corretta generazione del file FatturaPA.
                </div>

                <div class="alert alert-warning" role="alert"
                     invisible="pec_mode != 'test'">
                    <strong>Modalità TEST:</strong>
                    le fatture verranno inviate all'indirizzo PEC di test,
                    non all'SDI di produzione.
                </div>

                <div class="alert alert-danger" role="alert"
                     invisible="pec_mode != 'production'">
                    <strong>Modalità PRODUZIONE:</strong>
                    le fatture verranno inviate allo SDI ufficiale
                    (<field name="company_id" invisible="1"/>).
                    Questa azione è irreversibile.
                </div>

                <group string="Fatture selezionate">
                    <field name="move_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="amount_total"/>
                            <field name="l10n_it_edi_state"/>
                            <field name="l10n_it_pec_sent_date"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button name="action_send_via_pec"
                            string="📨 Invia via PEC"
                            type="object"
                            class="btn-primary"
                            invisible="pec_mode == 'disabled'"/>
                    <button name="action_preview_xml"
                            string="👁 Solo anteprima XML"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Annulla" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
