<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sdi_pec_transaction_view_form" model="ir.ui.view">
        <field name="name">sdi.pec.transaction.form</field>
        <field name="model">sdi.pec.transaction</field>
        <field name="arch" type="xml">
            <form string="Transazione SDI PEC" create="false" edit="false">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,sent,delivered,accepted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Riferimento">
                            <field name="move_id"/>
                            <field name="company_id"/>
                            <field name="direction"/>
                            <field name="transaction_type"/>
                        </group>
                        <group string="Identificativi SDI">
                            <field name="sdi_id"/>
                            <field name="sdi_filename"/>
                            <field name="sdi_message_id" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Contenuto" invisible="not xml_content">
                        <field name="xml_content" filename="xml_filename"/>
                        <field name="xml_filename" invisible="1"/>
                    </group>
                    <group string="Errore" invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                    <group string="Debug" groups="base.group_no_one" invisible="not raw_pec_content">
                        <field name="raw_pec_content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sdi_pec_transaction_view_list" model="ir.ui.view">
        <field name="name">sdi.pec.transaction.list</field>
        <field name="model">sdi.pec.transaction</field>
        <field name="arch" type="xml">
            <list string="Transazioni SDI PEC" create="false" edit="false">
                <field name="create_date" string="Data"/>
                <field name="move_id"/>
                <field name="direction"/>
                <field name="transaction_type"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('delivered', 'accepted')"
                       decoration-danger="state in ('rejected', 'error')"
                       decoration-info="state == 'sent'"
                       decoration-warning="state == 'demo'"/>
                <field name="sdi_id"/>
                <field name="sdi_filename"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="sdi_pec_transaction_view_search" model="ir.ui.view">
        <field name="name">sdi.pec.transaction.search</field>
        <field name="model">sdi.pec.transaction</field>
        <field name="arch" type="xml">
            <search string="Transazioni SDI">
                <field name="move_id"/>
                <field name="sdi_filename"/>
                <field name="sdi_id"/>
                <filter string="In uscita" name="out" domain="[('direction', '=', 'out')]"/>
                <filter string="In entrata" name="in" domain="[('direction', '=', 'in')]"/>
                <separator/>
                <filter string="Consegnate" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <filter string="Scartate" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Errore" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Direzione" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Stato" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'transaction_type'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
