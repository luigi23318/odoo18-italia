<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_pec_sdi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pec.sdi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Odoo 18 safe injection point -->
            <xpath expr="//div[contains(@class,'o_settings_container')]" position="inside">

                <h2 class="mt32">Fatturazione Elettronica PEC</h2>

                <!-- MODE -->
                <div class="o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="l10n_it_edi_pec_mode"/>
                        <div class="text-muted">
                            Modalità operativa per l'invio delle fatture elettroniche
                        </div>
                        <field name="l10n_it_edi_pec_mode" widget="radio"/>
                    </div>
                </div>

                <!-- PEC + SDI -->
                <div class="o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="l10n_it_edi_pec_address"/>
                        <field name="l10n_it_edi_pec_address"
                               placeholder="sdi@tuaazienda.pec.it"/>

                        <label for="l10n_it_edi_pec_sdi_address"/>
                        <field name="l10n_it_edi_pec_sdi_address"/>
                    </div>
                </div>

                <!-- MAIL SERVERS -->
                <div class="o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="l10n_it_edi_pec_server_out_id"/>
                        <field name="l10n_it_edi_pec_server_out_id"/>

                        <label for="l10n_it_edi_pec_server_in_id"/>
                        <field name="l10n_it_edi_pec_server_in_id"/>
                    </div>
                </div>

                <!-- CLEANUP -->
                <div class="o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="l10n_it_edi_pec_cleanup_mode"/>
                        <field name="l10n_it_edi_pec_cleanup_mode"/>

                        <label for="l10n_it_edi_pec_cleanup_days"
                               invisible="l10n_it_edi_pec_cleanup_mode != 'delete_delay'"/>
                        <field name="l10n_it_edi_pec_cleanup_days"
                               invisible="l10n_it_edi_pec_cleanup_mode != 'delete_delay'"/>
                    </div>
                </div>

            </xpath>

        </field>
    </record>

</odoo>