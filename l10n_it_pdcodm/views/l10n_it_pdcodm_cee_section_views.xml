<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Viste read-only per le 204 voci CEE di riclassificazione bilancio.
        La consultazione è permessa al gruppo `group_pdcodm_user`; la
        modifica solo al gruppo `group_pdcodm_administrator` (vedi ACL in
        security/ir.model.access.csv).
    -->

    <record id="view_l10n_it_pdcodm_cee_section_list" model="ir.ui.view">
        <field name="name">l10n_it_pdcodm.cee.section.list</field>
        <field name="model">l10n_it_pdcodm.cee.section</field>
        <field name="arch" type="xml">
            <list string="Voci CEE" create="0" delete="0" edit="0">
                <field name="code"/>
                <field name="description"/>
                <field name="section"/>
                <field name="statement"/>
                <field name="side"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_it_pdcodm_cee_section_form" model="ir.ui.view">
        <field name="name">l10n_it_pdcodm.cee.section.form</field>
        <field name="model">l10n_it_pdcodm.cee.section</field>
        <field name="arch" type="xml">
            <form string="Voce CEE" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="section" readonly="1"/>
                            <field name="statement" readonly="1"/>
                            <field name="side" readonly="1"/>
                        </group>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_it_pdcodm_cee_section_search" model="ir.ui.view">
        <field name="name">l10n_it_pdcodm.cee.section.search</field>
        <field name="model">l10n_it_pdcodm.cee.section</field>
        <field name="arch" type="xml">
            <search string="Cerca voce CEE">
                <field name="code"/>
                <field name="description"/>
                <field name="section"/>
                <separator/>
                <filter name="filter_sp" string="Stato Patrimoniale"
                        domain="[('statement', '=', 'Stato Patrimoniale')]"/>
                <filter name="filter_ce" string="Conto Economico"
                        domain="[('statement', '=', 'Conto Economico')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter name="group_by_section" string="Sezione di bilancio"
                            context="{'group_by': 'section'}"/>
                    <filter name="group_by_statement" string="Prospetto"
                            context="{'group_by': 'statement'}"/>
                    <filter name="group_by_side" string="Lato"
                            context="{'group_by': 'side'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_it_pdcodm_cee_section" model="ir.actions.act_window">
        <field name="name">Voci CEE</field>
        <field name="res_model">l10n_it_pdcodm.cee.section</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_it_pdcodm_cee_section_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nessuna voce CEE caricata.
            </p>
            <p>
                Le 204 voci CEE vengono caricate automaticamente all'installazione del
                modulo dal file <code>data/l10n_it_pdcodm.cee.section.csv</code>.
                Se la lista è vuota, controlla i log di installazione.
            </p>
        </field>
    </record>

    <menuitem id="menu_l10n_it_pdcodm_cee_section"
              name="Voci CEE"
              parent="account.menu_action_account_form"
              action="action_l10n_it_pdcodm_cee_section"
              groups="l10n_it_pdcodm.group_pdcodm_user"
              sequence="30"/>

</odoo>
