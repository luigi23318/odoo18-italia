<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Gruppi di sicurezza del modulo l10n_it_pdcodm.
        Gerarchia (SPEC sezione 11.1):
            group_pdcodm_user
                └─ implied: account.group_account_user
            group_pdcodm_manager
                └─ implied: group_pdcodm_user + account.group_account_manager
            group_pdcodm_administrator
                └─ implied: group_pdcodm_manager
    -->

    <record id="module_category_l10n_it_pdcodm" model="ir.module.category">
        <field name="name">PdC OdooManager</field>
        <field name="description">Permessi sul Piano dei Conti italiano professionale OdooManager.</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_pdcodm_user" model="res.groups">
        <field name="name">PdC OdooManager / User</field>
        <field name="category_id" ref="module_category_l10n_it_pdcodm"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_pdcodm_manager" model="res.groups">
        <field name="name">PdC OdooManager / Manager</field>
        <field name="category_id" ref="module_category_l10n_it_pdcodm"/>
        <field name="implied_ids" eval="[(4, ref('group_pdcodm_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <record id="group_pdcodm_administrator" model="res.groups">
        <field name="name">PdC OdooManager / Administrator</field>
        <field name="category_id" ref="module_category_l10n_it_pdcodm"/>
        <field name="implied_ids" eval="[(4, ref('group_pdcodm_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
