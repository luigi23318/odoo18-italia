<odoo>
    <record id="view_company_form_pec" model="ir.ui.view">
        <field name="name">res.company.pec</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="PEC Settings">
                    <field name="l10n_it_edi_transmission_mode"/>
                    <field name="pec_email"/>
                    <field name="pec_username"/>
                    <field name="pec_password" password="True"/>
                    <field name="pec_smtp_server"/>
                    <field name="pec_port"/>
                    <field name="sdi_pec_address"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
