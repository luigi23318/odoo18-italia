<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        OdooManager.cloud - Lock tabelle Dettagli E-Fattura (v3.0.1)

        Rende readonly le tabelle del tab 'Dettagli e-fattura' SOLO sulle
        fatture cliente (out_invoice, out_refund). Nasconde pulsanti
        "Aggiungi riga" e cestini nelle tabelle.

        Sulle fatture passive (in_invoice, in_refund) le tabelle restano
        editabili per preservare la compatibilità con l'import XML.

        Il controllo lato database è gestito dagli override Python nei
        modelli l10n_it_edi.line e l10n_it_edi.summary_data.
    -->

    <record id="view_move_form_om_lock_edi_tables" model="ir.ui.view">
        <field name="name">account.move.form.om.lock.edi.tables</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_edi_extension.account_invoice_form_l10n_it_inherit_view"/>
        <field name="arch" type="xml">

            <!-- Lock sulla tabella righe e-fattura sulle fatture cliente -->
            <xpath expr="//field[@name='l10n_it_edi_line_ids']" position="attributes">
                <attribute name="readonly">move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>

            <!-- Lock sulla tabella summary sulle fatture cliente -->
            <xpath expr="//field[@name='l10n_it_edi_summary_ids']" position="attributes">
                <attribute name="readonly">move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>

        </field>
    </record>

</odoo>
