<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_foreign_invoice_import" model="ir.sequence">
        <field name="name">Fattura estera importata</field>
        <field name="code">foreign.invoice.import</field>
        <field name="prefix">FEI/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_foreign_invoice_batch" model="ir.sequence">
        <field name="name">Batch fatture estere</field>
        <field name="code">foreign.invoice.batch</field>
        <field name="prefix">BATCH/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
