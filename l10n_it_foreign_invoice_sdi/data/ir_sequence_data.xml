<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_foreign_invoice_import" model="ir.sequence">
        <field name="name">Fattura Estera</field>
        <field name="code">foreign.invoice.import</field>
        <field name="prefix">FE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_foreign_invoice_batch" model="ir.sequence">
        <field name="name">Batch Fatture Estere</field>
        <field name="code">foreign.invoice.batch</field>
        <field name="prefix">BATCH/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_foreign_invoice_progressive" model="ir.sequence">
        <field name="name">Progressivo Invio FatturaPA</field>
        <field name="code">foreign.invoice.progressive</field>
        <field name="prefix"/>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
