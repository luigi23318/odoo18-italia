<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Categoria modulo -->
    <record id="module_category_foreign_invoice" model="ir.module.category">
        <field name="name">Fatture Estere SDI</field>
        <field name="sequence">50</field>
    </record>

    <!-- Gruppo Utente -->
    <record id="group_foreign_invoice_user" model="res.groups">
        <field name="name">Utente Fatture Estere</field>
        <field name="category_id" ref="module_category_foreign_invoice"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Gruppo Manager -->
    <record id="group_foreign_invoice_manager" model="res.groups">
        <field name="name">Responsabile Fatture Estere</field>
        <field name="category_id" ref="module_category_foreign_invoice"/>
        <field name="implied_ids" eval="[(4, ref('group_foreign_invoice_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_foreign_invoice_import_company" model="ir.rule">
        <field name="name">Fatture Estere: multi-company</field>
        <field name="model_id" ref="model_foreign_invoice_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_foreign_invoice_batch_company" model="ir.rule">
        <field name="name">Batch Fatture Estere: multi-company</field>
        <field name="model_id" ref="model_foreign_invoice_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
