<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_foreign_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.foreign.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Acquisizione fatture in PDF" string="Acquisizione fatture in PDF" data-key="l10n_it_foreign_invoice_sdi">
                    <h2>Acquisizione fatture in PDF</h2>

                    <!-- Scelta motore -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_extraction_engine" string="Motore di estrazione"/>
                                    <div class="text-muted">
                                        Scegli il motore per estrarre i dati dalle fatture PDF
                                    </div>
                                    <field name="foreign_invoice_extraction_engine" widget="radio"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Configurazione Tesseract -->
                    <div invisible="foreign_invoice_extraction_engine != 'tesseract'">
                        <h3 class="mt16">Configurazione Tesseract OCR</h3>
                        <div class="row o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_ocr_languages"/>
                                    <div class="text-muted">
                                        Lingue OCR separate da + (es: ita+eng+deu+fra+spa)
                                    </div>
                                    <field name="foreign_invoice_ocr_languages"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="foreign_invoice_use_builtin_templates"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_use_builtin_templates"/>
                                    <div class="text-muted">
                                        Usa i 12 template YAML inclusi nel modulo
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="foreign_invoice_auto_extract"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_auto_extract"/>
                                    <div class="text-muted">
                                        Estrae automaticamente al caricamento del PDF
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Configurazione A-Cube -->
                    <div invisible="foreign_invoice_extraction_engine != 'acube'">
                        <h3 class="mt16">Configurazione A-Cube API</h3>
                        <div class="row o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_acube_email"/>
                                    <field name="foreign_invoice_acube_email"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_acube_password"/>
                                    <field name="foreign_invoice_acube_password" password="True"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_acube_environment"/>
                                    <field name="foreign_invoice_acube_environment"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="foreign_invoice_acube_auto_send"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="foreign_invoice_acube_auto_send"/>
                                    <div class="text-muted">
                                        Invia automaticamente allo SDI dopo la validazione
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invio SDI via Aruba Premium -->
                    <h3 class="mt16">Invio SDI via Aruba Premium</h3>
                    <div class="row o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="foreign_invoice_sdi_active"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="foreign_invoice_sdi_active"/>
                                <div class="text-muted">
                                    Abilita invio diretto allo SDI via Aruba Premium API.
                                    Se disattivo, usare 'Scarica XML' per upload manuale.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row o_settings_container" invisible="not foreign_invoice_sdi_active">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="foreign_invoice_aruba_username"/>
                                <field name="foreign_invoice_aruba_username"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="foreign_invoice_aruba_password"/>
                                <field name="foreign_invoice_aruba_password" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="foreign_invoice_aruba_environment"/>
                                <field name="foreign_invoice_aruba_environment"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="foreign_invoice_codice_destinatario"/>
                                <field name="foreign_invoice_codice_destinatario"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="foreign_invoice_polling_frequency"/>
                                <field name="foreign_invoice_polling_frequency"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
