<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view -->
    <record id="view_foreign_invoice_import_form" model="ir.ui.view">
        <field name="name">foreign.invoice.import.form</field>
        <field name="model">foreign.invoice.import</field>
        <field name="arch" type="xml">
            <form string="Fattura estera">
                <header>
                    <button name="action_extract"
                            string="Estrai dati"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('bozza',)"/>
                    <button name="action_set_in_review"
                            string="Revisione"
                            type="object"
                            invisible="state not in ('dati_estratti', 'nessun_template')"/>
                    <button name="action_validate"
                            string="Valida"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('in_revisione', 'dati_estratti', 'nessun_template')"/>
                    <button name="action_generate_xml"
                            string="Genera XML"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'validato'"/>
                    <button name="action_send_sdi"
                            string="Invia al SDI"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'xml_generato'"/>
                    <button name="action_register_accounting"
                            string="Registra in contabilità"
                            type="object"
                            invisible="state not in ('consegnato', 'xml_generato', 'inviato_sdi')"/>
                    <button name="action_download_xml"
                            string="Scarica XML"
                            type="object"
                            invisible="not xml_attachment_id"/>
                    <button name="action_download_pdf"
                            string="Scarica PDF originale"
                            type="object"
                            invisible="not pdf_attachment_id"/>
                    <button name="action_reset_to_draft"
                            string="Riporta in bozza"
                            type="object"
                            invisible="state in ('bozza', 'registrato')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="bozza,dati_estratti,validato,xml_generato,inviato_sdi,consegnato,registrato"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="extraction_engine" readonly="1"/>
                            <field name="template_matched" readonly="1"
                                   invisible="extraction_engine != 'tesseract'"/>
                            <field name="batch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="pdf_attachment_id" readonly="state != 'bozza'"/>
                            <field name="reception_date"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Dati estratti -->
                        <page string="Dati estratti" name="extracted_data">
                            <group>
                                <group string="Fornitore">
                                    <field name="supplier_name"/>
                                    <field name="supplier_vat"/>
                                    <field name="supplier_country_id"/>
                                    <field name="partner_id"/>
                                </group>
                                <group string="Fattura">
                                    <field name="tipo_documento"/>
                                    <field name="invoice_number"/>
                                    <field name="invoice_date"/>
                                    <field name="currency_id"/>
                                    <field name="description_type"/>
                                </group>
                            </group>
                            <group>
                                <group string="Importi">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax_foreign"/>
                                    <field name="amount_total"/>
                                </group>
                                <group string="IVA italiana">
                                    <field name="it_tax_id"/>
                                    <field name="natura_code"/>
                                </group>
                            </group>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="line_total"/>
                                    <field name="tax_rate_foreign"/>
                                </list>
                            </field>
                            <group invisible="not validation_errors">
                                <field name="validation_errors" readonly="1"
                                       widget="text" class="text-danger"/>
                            </group>
                        </page>

                        <!-- Tab 2: PDF originale -->
                        <page string="PDF originale" name="pdf_preview"
                              invisible="not pdf_attachment_id">
                            <field name="raw_text" readonly="1"
                                   invisible="not raw_text"
                                   widget="text"
                                   placeholder="Testo estratto dal PDF..."/>
                        </page>

                        <!-- Tab 3: XML generato -->
                        <page string="XML generato" name="xml_preview"
                              invisible="not xml_attachment_id">
                            <field name="xml_content" readonly="1" widget="text"/>
                            <field name="xml_filename" readonly="1"/>
                        </page>

                        <!-- Tab 4: Stato SDI -->
                        <page string="Stato SDI" name="sdi_status"
                              invisible="state not in ('inviato_sdi', 'consegnato', 'scartato')">
                            <group>
                                <field name="sdi_state"/>
                                <field name="sdi_id"/>
                                <field name="sdi_filename"/>
                            </group>
                        </page>

                        <!-- Tab 5: Registrazione contabile -->
                        <page string="Registrazione contabile" name="accounting"
                              invisible="not account_move_id">
                            <group>
                                <field name="account_move_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_foreign_invoice_import_list" model="ir.ui.view">
        <field name="name">foreign.invoice.import.list</field>
        <field name="model">foreign.invoice.import</field>
        <field name="arch" type="xml">
            <list string="Fatture estere">
                <field name="name"/>
                <field name="supplier_name"/>
                <field name="supplier_vat"/>
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="tipo_documento"/>
                <field name="amount_total" sum="Totale"/>
                <field name="currency_id"/>
                <field name="state"
                       decoration-info="state in ('bozza', 'testo_estratto')"
                       decoration-warning="state in ('nessun_template', 'in_revisione')"
                       decoration-success="state in ('validato', 'xml_generato', 'consegnato', 'registrato')"
                       decoration-danger="state == 'scartato'"
                       widget="badge"/>
                <field name="batch_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_foreign_invoice_import_search" model="ir.ui.view">
        <field name="name">foreign.invoice.import.search</field>
        <field name="model">foreign.invoice.import</field>
        <field name="arch" type="xml">
            <search string="Cerca fatture estere">
                <field name="name"/>
                <field name="supplier_name"/>
                <field name="supplier_vat"/>
                <field name="invoice_number"/>
                <filter string="Bozza" name="draft" domain="[('state', '=', 'bozza')]"/>
                <filter string="Da validare" name="to_validate"
                        domain="[('state', 'in', ('dati_estratti', 'nessun_template', 'in_revisione'))]"/>
                <filter string="Validate" name="validated" domain="[('state', '=', 'validato')]"/>
                <filter string="XML generato" name="xml_ready" domain="[('state', '=', 'xml_generato')]"/>
                <filter string="Inviate SDI" name="sent_sdi" domain="[('state', '=', 'inviato_sdi')]"/>
                <filter string="Consegnate" name="delivered" domain="[('state', '=', 'consegnato')]"/>
                <filter string="Scartate" name="rejected" domain="[('state', '=', 'scartato')]"/>
                <filter string="Registrate" name="registered" domain="[('state', '=', 'registrato')]"/>
                <separator/>
                <filter string="Senza template" name="no_template"
                        domain="[('template_matched', '=', False)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Stato" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Tipo documento" name="group_td" context="{'group_by': 'tipo_documento'}"/>
                    <filter string="Paese fornitore" name="group_country"
                            context="{'group_by': 'supplier_country_id'}"/>
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Wizard singolo -->
    <record id="view_import_single_wizard_form" model="ir.ui.view">
        <field name="name">foreign.invoice.import.single.wizard.form</field>
        <field name="model">foreign.invoice.import.single.wizard</field>
        <field name="arch" type="xml">
            <form string="Importa fattura estera da PDF">
                <group>
                    <field name="pdf_file" filename="pdf_filename"/>
                    <field name="pdf_filename" invisible="1"/>
                    <field name="reception_date"/>
                    <field name="auto_extract"/>
                </group>
                <footer>
                    <button name="action_import" string="Importa" type="object" class="btn-primary"/>
                    <button string="Annulla" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_single_wizard" model="ir.actions.act_window">
        <field name="name">Importa fattura estera da PDF</field>
        <field name="res_model">foreign.invoice.import.single.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Wizard batch -->
    <record id="view_import_batch_wizard_form" model="ir.ui.view">
        <field name="name">foreign.invoice.import.batch.wizard.form</field>
        <field name="model">foreign.invoice.import.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Importa fatture estere da PDF (batch)">
                <group>
                    <field name="pdf_files" widget="many2many_binary"/>
                    <label for="zip_file" string="Oppure carica un file ZIP"/>
                    <field name="zip_file" filename="zip_filename" nolabel="1"/>
                    <field name="zip_filename" invisible="1"/>
                </group>
                <group>
                    <field name="reception_date"/>
                    <field name="tipo_documento_default"/>
                    <field name="auto_extract"/>
                </group>
                <footer>
                    <button name="action_import" string="Importa batch" type="object" class="btn-primary"/>
                    <button string="Annulla" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_batch_wizard" model="ir.actions.act_window">
        <field name="name">Importa fatture estere da PDF (batch)</field>
        <field name="res_model">foreign.invoice.import.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
