<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- FORM VIEW -->
    <!-- ============================================================ -->
    <record id="view_foreign_invoice_batch_form" model="ir.ui.view">
        <field name="name">foreign.invoice.batch.form</field>
        <field name="model">foreign.invoice.batch</field>
        <field name="arch" type="xml">
            <form string="Batch Fatture Estere">
                <header>
                    <button name="action_extract_all"
                            string="Estrai Tutti"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Avviare l'estrazione dati per tutte le fatture del batch?"/>
                    <button name="action_generate_all_xml"
                            string="Genera Tutti XML"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('extracted', 'reviewed')"/>
                    <button name="action_send_all_sdi"
                            string="Invia Tutti SDI"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'xml_generated'"
                            confirm="Confermi l'invio al SDI di tutte le fatture del batch?"/>
                    <button name="action_check_all_sdi_status"
                            string="Aggiorna Stato SDI"
                            type="object"
                            invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,extracted,reviewed,xml_generated,sent,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_imports"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-files-o">
                            <field name="import_count" widget="statinfo"
                                   string="Fatture"/>
                        </button>
                        <button name="action_download_all_xml"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-archive-o"
                                invisible="state == 'draft'">
                            <span>Download ZIP</span>
                        </button>
                        <button name="action_print_control_report"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-print">
                            <span>Report Controllo</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="import_count"/>
                            <field name="sent_count"/>
                            <field name="done_count"/>
                            <field name="error_count"
                                   decoration-danger="error_count > 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fatture" name="imports">
                            <field name="import_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="supplier_denomination"/>
                                    <field name="invoice_number"/>
                                    <field name="invoice_date"/>
                                    <field name="total_amount"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'error'"
                                           decoration-success="state == 'accepted'"
                                           decoration-info="state in ('sent', 'delivered')"
                                           decoration-warning="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="notes">
                            <field name="notes" placeholder="Note sul batch..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST VIEW -->
    <!-- ============================================================ -->
    <record id="view_foreign_invoice_batch_list" model="ir.ui.view">
        <field name="name">foreign.invoice.batch.list</field>
        <field name="model">foreign.invoice.batch</field>
        <field name="arch" type="xml">
            <list string="Batch Fatture Estere"
                  decoration-danger="state == 'error'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="import_count"/>
                <field name="sent_count"/>
                <field name="done_count"/>
                <field name="error_count"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'error'"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'sent'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW -->
    <!-- ============================================================ -->
    <record id="view_foreign_invoice_batch_search" model="ir.ui.view">
        <field name="name">foreign.invoice.batch.search</field>
        <field name="model">foreign.invoice.batch</field>
        <field name="arch" type="xml">
            <search string="Cerca Batch">
                <field name="name"/>
                <filter name="draft" string="Bozza"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="processing" string="In Elaborazione"
                        domain="[('state', 'in', ('processing', 'extracted', 'reviewed', 'xml_generated'))]"/>
                <filter name="sent" string="Inviati"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="done" string="Completati"
                        domain="[('state', '=', 'done')]"/>
                <filter name="error" string="In Errore"
                        domain="[('state', '=', 'error')]"/>
                <separator/>
                <group expand="0" string="Raggruppa per">
                    <filter name="group_state" string="Stato"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Tipo Documento"
                            context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION -->
    <!-- ============================================================ -->
    <record id="action_foreign_invoice_batch" model="ir.actions.act_window">
        <field name="name">Batch Fatture Estere</field>
        <field name="res_model">foreign.invoice.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_foreign_invoice_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea il tuo primo batch di fatture estere
            </p>
            <p>
                Importa multipli PDF in un unico batch per elaborazione massiva.
            </p>
        </field>
    </record>

</odoo>
