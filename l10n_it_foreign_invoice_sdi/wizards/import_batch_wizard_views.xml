<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_batch_wizard_form" model="ir.ui.view">
        <field name="name">foreign.invoice.import.batch.wizard.form</field>
        <field name="model">foreign.invoice.import.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Importa Batch Fatture Estere">
                <group>
                    <field name="upload_file" filename="upload_filename"/>
                    <field name="upload_filename" invisible="1"/>
                    <field name="document_type"/>
                    <field name="extraction_engine"/>
                    <field name="auto_extract"/>
                </group>
                <footer>
                    <button name="action_import"
                            string="Importa Batch"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annulla" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_batch_wizard" model="ir.actions.act_window">
        <field name="name">Importa Batch Fatture Estere</field>
        <field name="res_model">foreign.invoice.import.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
