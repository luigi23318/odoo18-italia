<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report action -->
    <record id="action_report_batch_control" model="ir.actions.report">
        <field name="name">Report controllo batch</field>
        <field name="model">foreign.invoice.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_it_foreign_invoice_sdi.batch_control_report</field>
        <field name="report_file">l10n_it_foreign_invoice_sdi.batch_control_report</field>
        <field name="print_report_name">'Report_Controllo_%s' % object.name</field>
        <field name="binding_model_id" ref="model_foreign_invoice_batch"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb template -->
    <template id="batch_control_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="batch">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Report controllo batch: <t t-esc="batch.name"/></h2>

                        <!-- Sezione 1: Riepilogo -->
                        <h3>Riepilogo</h3>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>Totale fatture</strong></td>
                                <td><t t-esc="batch.total_invoices"/></td>
                                <td><strong>Validate</strong></td>
                                <td><t t-esc="batch.total_validated"/></td>
                            </tr>
                            <tr>
                                <td><strong>Con template</strong></td>
                                <td><t t-esc="batch.total_matched"/></td>
                                <td><strong>Senza template</strong></td>
                                <td><t t-esc="batch.total_unmatched"/></td>
                            </tr>
                            <tr>
                                <td><strong>Totale importi</strong></td>
                                <td><t t-esc="'%.2f' % batch.total_amount"/></td>
                                <td><strong>Con errori</strong></td>
                                <td><t t-esc="batch.total_errors"/></td>
                            </tr>
                        </table>

                        <!-- Distribuzione per TD -->
                        <h4>Distribuzione per tipo documento</h4>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Tipo</th><th>Quantità</th></tr></thead>
                            <tbody>
                                <t t-foreach="td_distribution.items()" t-as="item">
                                    <tr>
                                        <td><t t-esc="item[0]"/></td>
                                        <td><t t-esc="item[1]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Distribuzione per paese -->
                        <h4>Distribuzione per paese</h4>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Paese</th><th>Quantità</th></tr></thead>
                            <tbody>
                                <t t-foreach="country_distribution.items()" t-as="item">
                                    <tr>
                                        <td><t t-esc="item[0]"/></td>
                                        <td><t t-esc="item[1]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Sezione 2: Elenco fatture -->
                        <h3>Elenco fatture</h3>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Rif.</th>
                                    <th>Fornitore</th>
                                    <th>N. fattura</th>
                                    <th>Data</th>
                                    <th>TD</th>
                                    <th>Importo</th>
                                    <th>Valuta</th>
                                    <th>Stato</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="batch.invoice_ids" t-as="inv">
                                    <tr t-attf-class="#{'table-danger' if inv.state == 'scartato' else 'table-success' if inv.state in ('consegnato', 'registrato') else 'table-warning' if inv.validation_errors else ''}">
                                        <td><t t-esc="inv.name"/></td>
                                        <td><t t-esc="inv.supplier_name"/></td>
                                        <td><t t-esc="inv.invoice_number"/></td>
                                        <td><t t-esc="inv.invoice_date"/></td>
                                        <td><t t-esc="inv.tipo_documento"/></td>
                                        <td class="text-end"><t t-esc="'%.2f' % inv.amount_total"/></td>
                                        <td><t t-esc="inv.currency_id.name"/></td>
                                        <td><t t-esc="inv.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Sezione 3: Segnalazioni -->
                        <t t-if="warnings">
                            <h3>Segnalazioni</h3>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Fattura</th>
                                        <th>Tipo</th>
                                        <th>Messaggio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="warnings" t-as="w">
                                        <tr class="table-warning">
                                            <td><t t-esc="w['invoice']"/></td>
                                            <td><t t-esc="w['type']"/></td>
                                            <td><t t-esc="w['message']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
